<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.omen-keyboard-rgb</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/omen-keyboard-rgb/OmenKeyboardService</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/usr/local/bin/omen-keyboard-rgb</string>

    <!-- Run as root to access the raw HID device -->
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>

    <!-- Start at boot and restart on crash (mirrors systemd's Restart=on-failure) -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/var/log/omen-keyboard-rgb.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/omen-keyboard-rgb.log</string>
</dict>
</plist>
