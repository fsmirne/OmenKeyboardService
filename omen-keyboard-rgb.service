[Unit]
Description=HP Omen Sequencer Keyboard RGB Service
After=local-fs.target
# Prevent tight restart loops during boot — max 3 restarts per 60 seconds
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
# Path to the executable - update this to match your installation directory
ExecStart=/usr/local/bin/omen-keyboard-rgb/OmenKeyboardService
WorkingDirectory=/usr/local/bin/omen-keyboard-rgb
Restart=on-failure
RestartSec=10s
# Give the service generous time to pass the readiness gate before systemd kills it
TimeoutStartSec=120

# Run as root to access HID devices
User=root
Group=root

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omen-keyboard-rgb

[Install]
WantedBy=multi-user.target
