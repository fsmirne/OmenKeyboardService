[Unit]
Description=HP Omen Sequencer Keyboard RGB Service
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
ExecStart=/usr/local/bin/omen-keyboard-rgb/OmenKeyboardService
WorkingDirectory=/usr/local/bin/omen-keyboard-rgb
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30

# Run as root to access HID devices
User=root
Group=root

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omen-keyboard-rgb

[Install]
WantedBy=multi-user.target
